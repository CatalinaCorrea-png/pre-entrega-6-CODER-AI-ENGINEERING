# Copiar a .env y completar. El .env está en .gitignore y nunca se sube al repositorio.

# LLM y embeddings — Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Pinecone — clave gratuita en https://app.pinecone.io
PINECONE_API_KEY=

# Modelo de Gemini para el supervisor, los especialistas y la síntesis.
# flash-lite porque la capa gratuita le da 15 pedidos por minuto (contra 5 de
# gemini-flash-latest) y una consulta completa hace ~8 llamadas al LLM.
MODELO_LLM=gemini-flash-lite-latest

# Índice y namespace de Pinecone. No es el índice del notebook de la clase
# (techcorp-rag-hibrido, 384 dims con MiniLM): este usa embeddings de Gemini de 1536.
# Si tu cuenta llegó al tope de índices gratuitos, podés apuntar al índice de la
# pre-entrega 4 (INDEX_NAME=pydantic-docs-rag): el namespace mantiene los corpus separados.
INDEX_NAME=techcorp-politicas
PINECONE_NAMESPACE=politicas-internas

# Región del índice serverless. La capa gratuita de Pinecone solo admite aws/us-east-1.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
